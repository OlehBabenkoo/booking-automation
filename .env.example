BASE_URL=https://www.example.com

# Dead Simple Email API key (used for every inbox unless a role has its own key)
DSE_API_KEY=

# Sign-in / sign-out tests (@otp): one inbox per project
DSE_EMAIL_CHROME_DESKTOP=
DSE_EMAIL_CHROME_MOBILE=
DSE_EMAIL_SAFARI_DESKTOP=
DSE_EMAIL_SAFARI_MOBILE=

# Shared signed-in session for tests that need a user (authTest)
DSE_EMAIL_SHARED=

# Tests that change account-wide data (accountSettingsTest): one inbox per project
DSE_API_KEY_SETTINGS=
DSE_EMAIL_SETTINGS_CHROME_DESKTOP=
DSE_EMAIL_SETTINGS_CHROME_MOBILE=
DSE_EMAIL_SETTINGS_SAFARI_DESKTOP=
DSE_EMAIL_SETTINGS_SAFARI_MOBILE=
